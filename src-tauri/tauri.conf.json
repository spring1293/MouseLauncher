{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MouseLauncher",
  "version": "0.1.0",
  "identifier": "com.mouselauncher.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "url": "launcher/index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "width": 300,
        "height": 300,
        "resizable": false,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "url": "settings/index.html",
        "decorations": true,
        "visible": false,
        "width": 480,
        "height": 600,
        "resizable": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
